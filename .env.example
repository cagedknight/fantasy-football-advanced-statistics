# Copy to .env and adjust. Never commit .env.

# --- api ---
ENVIRONMENT=local
PORT=8000

# Matches the credentials in infra/compose.yml.
DATABASE_URL=postgresql+asyncpg://fantasy:fantasy@localhost:5432/fantasy

# Comma separated. The Vite dev server runs on 5173.
CORS_ORIGINS=http://localhost:5173

# --- web ---
# Read at build time by Vite. Must be prefixed VITE_ to be exposed.
VITE_API_URL=http://localhost:8000
